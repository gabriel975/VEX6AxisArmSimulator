{"mode":"Text","hardwareTarget":"arm","textContent":"#region VEXcode Generated Robot Configuration\nfrom cte import *\nimport math\nimport random\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Robot configuration code\narm = Arm()\nsignal_tower = arm.signal_tower\n\n\n# Wait for sensor(s) to fully initialize\nwait(100, MSEC)\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode CTE Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom cte import *\n\ncolCounter = [3,3,3]\npalletInfo = (\n    (1,1,1), # P1\n    (2,2,2)  # P2\n)\ncolorHeights = (25,10,10)\npalletPositions = ((50,150,20),(150,50,20))\n\n\narm.move_to(120, 0, 100)\ndef main():\n    palPosHeights = [\n    [[0,0],[0,0]],\n    [[0,0],[0,0]]\n]\n    def buffe(x,y,z): # moves up to avoid hitting things then back down to defined pos\n        arm.move_inc(0,0,100)\n        arm.move_to(x,y,arm.get_z())\n        arm.move_to(x,y,z)\n    #175,75   75, 175\n    def goPalletPos(pNumber, cubeNum, colInd,i): # pallet number(0 or 1), Cube Number(Position on pallet), color index(which color it is 0-2)\n        x = cubeNum % 2\n        y = (cubeNum // 2) % 2\n        z = cubeNum // 4\n        palPosH=palPosHeights[i]\n        buffe(pNumber[0]+(x*50),pNumber[1]+(y*50),pNumber[2]+palPosH[x][y]+colorHeights[colInd])\n        palPosH[x][y]+=colorHeights[colInd]\n    \n    def grabColor(c):\n        if c == 0:\n            x,y,z=150,200,colorHeights[c]*colCounter[c] # color 1\n        elif c == 1:\n            x,y,z=200,200,colorHeights[c]*colCounter[c] # color 2\n        else:\n            x,y,z=200,150,colorHeights[c]*colCounter[c] # color 3\n\n        buffe(x,y,z)\n        colCounter[c]-=1\n        arm.set_end_effector_magnet(True)\n\n    def ful(pInfo):\n        pN=-1\n        for ind,pal in enumerate(pInfo): # each pallet\n            pN=pN+1\n            pCubes = 0\n            for j,colNum in enumerate(pal): # each color\n                for i in range(colNum): # each cube\n                    grabColor(j)\n                    goPalletPos(palletPositions[ind],pCubes,j,ind)\n                    arm.set_end_effector_magnet(False)\n                    pCubes+=1\n                    \n\n    ful(palletInfo)\n\ncte_thread(main)","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}