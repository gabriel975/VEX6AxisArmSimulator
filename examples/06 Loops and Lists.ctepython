{"mode":"Text","hardwareTarget":"arm","textContent":"#region VEXcode Generated Robot Configuration\nfrom cte import *\nimport math\nimport random\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Robot configuration code\narm = Arm()\nsignal_tower = arm.signal_tower\n\n\n# Wait for sensor(s) to fully initialize\nwait(100, MSEC)\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode CTE Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom cte import *\n\n\n# Loops and Lists - visit a list of Tile squares with a for loop.\n#\n# Instead of writing the same three lines for every square, keep the squares\n# in a list and loop over it. Each visit: hover above the square, touch down\n# 5 mm above the Tile, lift again.\n\nTOUCH = 5\nHOVER = 60\n\n# (x, y) of the squares to visit - all free in the default scene\nsquares = [\n    (150, 0),      # 26\n    (150, 100),    # 28\n    (100, 100),    # 22\n    (200, 100),    # 34\n]\n\n# Add project code in \"main\"\ndef main():\n    arm.move_to(120, 0, 100)\n    count = 0\n    for x, y in squares:\n        count = count + 1\n        brain.screen.print(\"Square\", count, \"of\", len(squares), \"at\", x, y)\n        brain.screen.next_row()\n        arm.move_to(x, y, HOVER)\n        arm.move_to(x, y, TOUCH)\n        arm.move_to(x, y, HOVER)\n    brain.screen.print(\"Visited\", count, \"squares\")\n    arm.move_to(120, 0, 100)\n\n# CTE threads — Do not delete\ncte_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}