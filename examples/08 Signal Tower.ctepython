{"mode":"Text","hardwareTarget":"arm","textContent":"#region VEXcode Generated Robot Configuration\nfrom cte import *\nimport math\nimport random\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Robot configuration code\narm = Arm()\nsignal_tower = arm.signal_tower\n\n\n# Wait for sensor(s) to fully initialize\nwait(100, MSEC)\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode CTE Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom cte import *\n\n\n# Signal Tower - lights and the button.\n#\n# The Signal Tower has five lamps (RED, YELLOW, GREEN, BLUE, WHITE) that can be\n# ON, OFF or BLINK, and a button on top. While a program runs, pressing the\n# button normally does a controlled stop; if the program registers a\n# `pressed` handler it gets the press instead. In the simulator the button\n# is the Tower in the panel, or the B key.\n\nbutton_presses = 0\n\n# Add project code in \"main\"\ndef on_button():\n    # Called every time the Signal Tower button is pressed while we run.\n    global button_presses\n    button_presses = button_presses + 1\n    signal_tower.set_color(SignalTower.WHITE, SignalTower.BLINK)\n    brain.screen.print(\"Button pressed! (\", button_presses, \")\")\n    brain.screen.next_row()\n\ndef main():\n    signal_tower.pressed(on_button)\n    arm.move_to(120, 0, 100)\n\n    # Light the lamps one by one, like a traffic light sequence.\n    for colour in [SignalTower.RED, SignalTower.YELLOW, SignalTower.GREEN, SignalTower.BLUE]:\n        signal_tower.set_color(SignalTower.ALL, SignalTower.OFF)\n        signal_tower.set_color(colour, SignalTower.ON)\n        wait(600, MSEC)\n\n    # Blink green while the arm works, then stop blinking.\n    signal_tower.set_color(SignalTower.ALL, SignalTower.OFF)\n    signal_tower.set_color(SignalTower.GREEN, SignalTower.BLINK)\n    arm.move_to(170, -40, 60)\n    arm.move_to(170, 40, 60)\n    arm.move_to(120, 0, 100)\n\n    # Wait a few seconds so you can try the button.\n    brain.screen.print(\"Press the Signal Tower button (B) now...\")\n    brain.screen.next_row()\n    wait(4, SECONDS)\n\n    signal_tower.set_color(SignalTower.ALL, SignalTower.OFF)\n    brain.screen.print(\"Button was pressed\", button_presses, \"time(s)\")\n\n# CTE threads — Do not delete\ncte_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}