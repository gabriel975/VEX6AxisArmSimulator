{"mode":"Text","hardwareTarget":"arm","textContent":"from cte import *\nimport math\nimport random\n\nbrain = Brain()\narm = Arm()\nsignal_tower = arm.signal_tower\n\nwait(100, MSEC)\n\nfrom cte import *\n\nclass Pallet:\n    def __init__(self,x,y,h):\n        self.x = x\n        self.y = y\n        self.h = h\n        self.dat = [[[False for _ in range(3)] for _ in range(3)] for _ in range(3)]\n\n    def getPos(self,a,b,c):\n        fx = self.x+25*a+12\n        fy = self.y+25*b+12\n        fz = self.h+25*(b+1)\n        return [fx,fy,fz]\n\n    def getPosX(self,a,b,c):\n        fx = self.x+25*a+12\n        return fx\n\n    def getPosY(self,a,b,c):\n        fy = self.y+25*b+12\n        return fy\n\n    def getPosZ(self,a,b,c):\n        fz = self.h+25*(b+1)\n        return fz\n\n    def isCube(self,a,b,c):\n        return self.dat[a][b][c]\n\n    def setCube(self,a,b,c,state):\n        self.dat[a][b][c] = state\n\np = Pallet(100,100,20)\npos = p.getPos(0,0,0)\nx=p.getPosX(0,0,0)\ny=p.getPosY(0,0,0)\nz=p.getPosZ(0,0,0)\narm.move_to(x,y,z)","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}