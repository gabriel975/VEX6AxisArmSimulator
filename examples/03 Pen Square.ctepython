{"mode":"Text","hardwareTarget":"arm","textContent":"#region VEXcode Generated Robot Configuration\nfrom cte import *\nimport math\nimport random\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Robot configuration code\narm = Arm()\nsignal_tower = arm.signal_tower\n\n\n# Wait for sensor(s) to fully initialize\nwait(100, MSEC)\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode CTE Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom cte import *\n\n\n# Pen Square - draw with the Pen Holder Tool.\n#\n# With the pen tool the tool centre point is the pen tip, so Z = 0 means\n# \"pen on the Tile\" (put a sheet of paper or the dry-erase board there).\n# Lift the pen a little between shapes so it does not draw a line across.\n\nLIFT = 15        # mm above the paper when travelling\n\n# Add project code in \"main\"\ndef draw_polygon(points):\n    # Travel to the first corner with the pen lifted, lower it, then trace\n    # every corner and close the shape by coming back to the first one.\n    x0, y0 = points[0]\n    arm.move_to(x0, y0, LIFT)\n    arm.move_to(x0, y0, 0)\n    for x, y in points[1:] + [points[0]]:\n        arm.move_to(x, y, 0)\n    arm.move_to(x, y, LIFT)\n\ndef main():\n    arm.move_to(120, 0, 100)                 # Safe Position\n    arm.set_end_effector_type(Arm.PEN)       # swap the magnet for the pen\n    brain.screen.print(\"Drawing a square and a triangle\")\n    brain.screen.next_row()\n\n    # A 50 mm square to the right of the arm (negative Y), away from the cubes.\n    draw_polygon([(110, -70), (160, -70), (160, -20), (110, -20)])\n\n    # A triangle further out.\n    draw_polygon([(190, -80), (240, -80), (215, -30)])\n\n    arm.move_to(120, 0, 100)\n    brain.screen.print(\"Done. Press C to clear the drawing.\")\n\n# CTE threads — Do not delete\ncte_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}