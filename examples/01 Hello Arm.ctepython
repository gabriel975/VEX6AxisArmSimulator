{"mode":"Text","hardwareTarget":"arm","textContent":"#region VEXcode Generated Robot Configuration\nfrom cte import *\nimport math\nimport random\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Robot configuration code\narm = Arm()\nsignal_tower = arm.signal_tower\n\n\n# Wait for sensor(s) to fully initialize\nwait(100, MSEC)\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode CTE Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom cte import *\n\n\n# Hello Arm - the smallest useful program.\n#\n# The arm's coordinates are in millimetres: X points out in front of the arm,\n# Y to its left, Z up. (0, 0, 0) is the centre of the base on the Tile, and each\n# numbered square on the Tile is 50 mm wide, so square 36 is at (200, 200).\n#\n# Every program should start from the Safe Position (120, 0, 100): a spot\n# high above the Tile that the arm can always reach.\n\n# Add project code in \"main\"\ndef main():\n    brain.screen.print(\"Hello from the 6-Axis Arm!\")\n    brain.screen.next_row()\n\n    # Go to the Safe Position first.\n    arm.move_to(120, 0, 100)\n\n    # Visit the centres of three Tile squares, 30 mm above the surface.\n    arm.move_to(150, 0, 30)      # square 26\n    arm.move_to(150, 100, 30)    # square 28\n    arm.move_to(100, 100, 30)    # square 22\n\n    # The getters tell you where the tool centre point (TCP) is right now.\n    brain.screen.print(\"Now at X =\", arm.get_x(), \"Y =\", arm.get_y(), \"Z =\", arm.get_z())\n    brain.screen.next_row()\n\n    # Finish at the Safe Position.\n    arm.move_to(120, 0, 100)\n    brain.screen.print(\"Done - back at the Safe Position\")\n\n# CTE threads — Do not delete\ncte_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}