{"mode":"Text","hardwareTarget":"arm","textContent":"#region VEXcode Generated Robot Configuration\nfrom cte import *\nimport math\nimport random\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Robot configuration code\narm = Arm()\nsignal_tower = arm.signal_tower\n\n\n# Wait for sensor(s) to fully initialize\nwait(100, MSEC)\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode CTE Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom cte import *\n\n\n# Stack Cubes - put the red cube on top of the blue cube.\n#\n# Default scene (press N to reset): red cube on square 27 at (150, 50),\n# blue cube on square 29 at (150, 150). Both are 25 mm tall.\n#\n# When the magnet holds a cube, the cube's bottom is 27 mm below the tool\n# (we grabbed it with the tool 2 mm above its top). To set it down on the\n# blue cube, whose top is at Z = 25, the tool has to stop at 25 + 27 = 52.\n\nCUBE = 25\nHOVER = 90\n\n# Add project code in \"main\"\ndef main():\n    arm.move_to(120, 0, 100)\n    arm.set_end_effector_type(Arm.MAGNET)\n\n    # pick the red cube\n    arm.move_to(150, 50, HOVER)\n    arm.move_to(150, 50, CUBE + 2)\n    arm.set_end_effector_magnet(True)\n    wait(300, MSEC)\n    arm.move_to(150, 50, HOVER)\n\n    # carry it over the blue cube and set it down on top\n    arm.move_to(150, 150, HOVER)\n    arm.move_to(150, 150, CUBE + CUBE + 2)\n    arm.set_end_effector_magnet(False)\n    wait(300, MSEC)\n    arm.move_to(150, 150, HOVER)\n\n    brain.screen.print(\"Stacked: red cube on blue cube, top at Z =\", 2 * CUBE)\n    arm.move_to(120, 0, 100)\n\n# CTE threads — Do not delete\ncte_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}