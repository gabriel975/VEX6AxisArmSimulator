{"mode":"Text","hardwareTarget":"arm","textContent":"#region VEXcode Generated Robot Configuration\nfrom cte import *\nimport math\nimport random\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Robot configuration code\narm = Arm()\nsignal_tower = arm.signal_tower\n\n\n# Wait for sensor(s) to fully initialize\nwait(100, MSEC)\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode CTE Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom cte import *\n\n\n# Functions - reusable helpers for picking and placing.\n#\n# Real programs move many objects. Put the moves into functions once and call\n# them with different coordinates. Default scene (press N to reset):\n# red cube on square 27 at (150, 50, top 25), green disk on square 18 at\n# (50, 200, top 8).\n#\n# This program moves both objects to new squares, then puts them back.\n\nHOVER = 80\n\n# Add project code in \"main\"\ndef go_above(x, y):\n    # Travel at a safe height to a spot above (x, y).\n    arm.move_to(x, y, HOVER)\n\ndef pick(x, y, top):\n    # Grab the object whose top surface is at height `top`.\n    go_above(x, y)\n    arm.move_to(x, y, top + 2)\n    arm.set_end_effector_magnet(True)\n    wait(250, MSEC)\n    go_above(x, y)\n\ndef place(x, y, top):\n    # Set a held object down so that its top ends up at height `top`.\n    go_above(x, y)\n    arm.move_to(x, y, top + 2)\n    arm.set_end_effector_magnet(False)\n    wait(250, MSEC)\n    go_above(x, y)\n\ndef move_object(name, x0, y0, x1, y1, top):\n    brain.screen.print(\"Moving the\", name, \"to\", x1, y1)\n    brain.screen.next_row()\n    pick(x0, y0, top)\n    place(x1, y1, top)\n\ndef main():\n    arm.move_to(120, 0, 100)\n    arm.set_end_effector_type(Arm.MAGNET)\n\n    move_object(\"red cube\", 150, 50, 200, 0, 25)      # 27 -> 32\n    move_object(\"green disk\", 50, 200, 100, 200, 8)   # 18 -> 24\n\n    # ... and back where they came from\n    move_object(\"red cube\", 200, 0, 150, 50, 25)\n    move_object(\"green disk\", 100, 200, 50, 200, 8)\n\n    brain.screen.print(\"All objects back in place\")\n    arm.move_to(120, 0, 100)\n\n# CTE threads — Do not delete\ncte_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}