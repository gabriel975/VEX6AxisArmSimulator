{"mode":"Text","hardwareTarget":"arm","textContent":"#region VEXcode Generated Robot Configuration\nfrom cte import *\nimport math\nimport random\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Robot configuration code\narm = Arm()\nsignal_tower = arm.signal_tower\n\n\n# Wait for sensor(s) to fully initialize\nwait(100, MSEC)\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode CTE Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom cte import *\n\n\n# Pick and Place Basics - carry the red cube to another square with the magnet.\n#\n# Start from the default scene (press N to reset it): the red cube sits on\n# square 27 at (150, 50). The cubes are 25 mm tall, so the magnet should touch\n# the cube's top at Z = 25. We approach from above and leave upwards so the\n# arm never sweeps through the other objects.\n\nHOVER = 80       # safe travelling height above the Tile\nGRAB  = 27       # tool height that touches the top of a 25 mm cube\n\n# Add project code in \"main\"\ndef main():\n    arm.move_to(120, 0, 100)                 # Safe Position\n    arm.set_end_effector_type(Arm.MAGNET)\n\n    # --- pick --------------------------------------------------------------\n    arm.move_to(150, 50, HOVER)              # above the red cube\n    arm.move_to(150, 50, GRAB)               # down onto it\n    arm.set_end_effector_magnet(True)        # grab\n    wait(300, MSEC)\n    arm.move_to(150, 50, HOVER)              # lift it\n    brain.screen.print(\"Picked up the red cube\")\n    brain.screen.next_row()\n\n    # --- place -------------------------------------------------------------\n    arm.move_to(200, 50, HOVER)              # over square 33\n    arm.move_to(200, 50, GRAB)               # lower it onto the Tile\n    arm.set_end_effector_magnet(False)       # release - it settles on the Tile\n    wait(300, MSEC)\n    arm.move_to(200, 50, HOVER)              # retreat upwards\n    brain.screen.print(\"Placed it on square 33\")\n\n    arm.move_to(120, 0, 100)\n\n# CTE threads — Do not delete\ncte_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}