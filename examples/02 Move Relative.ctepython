{"mode":"Text","hardwareTarget":"arm","textContent":"#region VEXcode Generated Robot Configuration\nfrom cte import *\nimport math\nimport random\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Robot configuration code\narm = Arm()\nsignal_tower = arm.signal_tower\n\n\n# Wait for sensor(s) to fully initialize\nwait(100, MSEC)\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode CTE Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom cte import *\n\n\n# Move Relative - move_inc() moves BY an amount, move_to() moves TO a point.\n#\n# move_inc(dx, dy, dz) adds dx, dy, dz to where the tool is now. It is handy\n# for \"go up 50 mm\" or \"step 25 mm sideways\" without working out coordinates.\n\n# Add project code in \"main\"\ndef report(label):\n    brain.screen.print(label, \"->\", arm.get_x(), arm.get_y(), arm.get_z())\n    brain.screen.next_row()\n\ndef main():\n    arm.move_to(120, 0, 100)             # Safe Position\n    report(\"start\")\n\n    arm.move_inc(60, 0, 0)               # 60 mm forward (+X)\n    report(\"+60 in X\")\n\n    arm.move_inc(0, -60, 0)              # 60 mm to the arm's right (-Y)\n    report(\"-60 in Y\")\n\n    arm.move_inc(0, 0, -70)              # 70 mm down (+Z is up)\n    report(\"-70 in Z\")\n\n    # Three small steps sideways, like a stepper motor.\n    for i in range(3):\n        arm.move_inc(0, 25, 0)\n        report(\"step \" + str(i + 1))\n\n    arm.move_inc(0, 0, 70)               # back up\n    arm.move_to(120, 0, 100)             # and back to the Safe Position\n    report(\"end\")\n\n# CTE threads — Do not delete\ncte_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}