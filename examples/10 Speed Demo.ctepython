{"mode":"Text","hardwareTarget":"arm","textContent":"#region VEXcode Generated Robot Configuration\nfrom cte import *\nimport math\nimport random\n\n# Brain should be defined by default\nbrain = Brain()\n\n# Robot configuration code\narm = Arm()\nsignal_tower = arm.signal_tower\n\n\n# Wait for sensor(s) to fully initialize\nwait(100, MSEC)\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode CTE Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom cte import *\n\n\n# Speed Demo - the same move at different speeds.\n#\n# arm.set_speed(percent) sets how fast the arm moves (1-100 %, default 50).\n# Slow is safer near objects and when the magnet carries something; fast is\n# fine for travelling high above the Tile. brain.timer_time() measures how\n# long each move took.\n\nA = (100, -60, 60)\nB = (200, 60, 60)\n\n# Add project code in \"main\"\ndef timed_move(label):\n    brain.timer_reset()\n    arm.move_to(A[0], A[1], A[2])\n    arm.move_to(B[0], B[1], B[2])\n    arm.move_to(A[0], A[1], A[2])\n    seconds = brain.timer_time(SECONDS)\n    brain.screen.print(label, \"took\", round(seconds, 1), \"s\")\n    brain.screen.next_row()\n\ndef main():\n    arm.move_to(120, 0, 100)\n\n    arm.set_speed(20)\n    timed_move(\"Speed 20 %\")\n\n    arm.set_speed(100)\n    timed_move(\"Speed 100 %\")\n\n    arm.set_speed(50)                        # back to the default\n    timed_move(\"Speed 50 %\")\n\n    arm.move_to(120, 0, 100)\n    brain.screen.print(\"Done\")\n\n# CTE threads — Do not delete\ncte_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"arm","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","minVersion":"4.0.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}